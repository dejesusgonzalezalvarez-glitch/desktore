{% comment %}
  Renders a bundle offer selector for product pages.

  Each block is an offer rendered as a radio card. The first block can reuse the current product
  (single-item offer); the rest point to bundle products created in Shopify admin.

  Add-to-cart is handled by `assets/bundle-offers.js` through the Ajax Cart API, so no app is
  required. Free gift notes are copy-only: create a $0 gift variant and add it in admin if you
  want the gift to appear as a cart line.
{% endcomment %}

<script
  type="module"
  src="{{ 'bundle-offers.js' | asset_url }}"
  fetchpriority="low"
></script>

{%- liquid
  assign has_default = false
  for block in section.blocks
    if block.settings.default_selected
      assign has_default = true
    endif
  endfor
-%}

<div
  class="bundle-offers"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="bundle-offers__container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="bundle-offers__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="bundle-offers__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bundle-offers__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <bundle-offers-component
      class="bundle-offers__component"
      data-add-url="{{ routes.cart_add_url }}.js"
      data-cart-url="{{ routes.cart_url }}.json"
    >
      <fieldset class="bundle-offers__fieldset">
        <legend class="visually-hidden">{{ section.settings.heading | default: 'Choose your offer' }}</legend>

        <div class="bundle-offers__grid">
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.use_current_product
                assign offer_product = product
              else
                assign offer_product = block.settings.product
              endif

              if offer_product == blank
                if request.design_mode
                  echo '<div class="bundle-offers__placeholder">Select a product for this offer</div>'
                endif
                continue
              endif

              assign offer_variant = offer_product.selected_or_first_available_variant

              if offer_variant == blank
                continue
              endif

              assign offer_price = offer_variant.price

              assign compare_price = 0
              if block.settings.compare_price > 0
                assign compare_price = block.settings.compare_price | times: 100
              elsif offer_variant.compare_at_price > offer_price
                assign compare_price = offer_variant.compare_at_price
              endif

              assign savings = 0
              if compare_price > offer_price
                assign savings = compare_price | minus: offer_price
              endif

              assign is_checked = false
              if block.settings.default_selected
                assign is_checked = true
              elsif has_default == false and forloop.first
                assign is_checked = true
              endif
            -%}

            <label
              class="bundle-offers__offer{% if block.settings.highlight %} bundle-offers__offer--highlight{% endif %}"
              {{ block.shopify_attributes }}
            >
              <input
                type="radio"
                class="bundle-offers__radio"
                name="bundle-offer-{{ section.id }}"
                value="{{ offer_variant.id }}"
                data-formatted-price="{{ offer_price | money }}"
                data-available="{{ offer_variant.available }}"
                {% if is_checked %}
                  checked
                {% endif %}
              >

              <span class="bundle-offers__offer-body">
                <span class="bundle-offers__offer-top">
                  <span class="bundle-offers__offer-title">
                    {{ block.settings.title | replace: '{title}', offer_product.title | default: offer_product.title }}
                  </span>

                  {%- if block.settings.badge != blank -%}
                    <span class="bundle-offers__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                </span>

                {%- if block.settings.description != blank -%}
                  <span class="bundle-offers__offer-description">{{ block.settings.description | replace: '{title}', offer_product.title }}</span>
                {%- endif -%}

                <span class="bundle-offers__offer-pricing">
                  <span class="bundle-offers__price">{{ offer_price | money }}</span>

                  {%- if compare_price > offer_price -%}
                    <s class="bundle-offers__compare">{{ compare_price | money }}</s>
                  {%- endif -%}

                  {%- if savings > 0 and section.settings.show_savings -%}
                    <span class="bundle-offers__savings">Save {{ savings | money }}</span>
                  {%- endif -%}
                </span>

                {%- if block.settings.gift_note != blank -%}
                  <span class="bundle-offers__gift">
                    <span class="bundle-offers__gift-icon" aria-hidden="true">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    </span>
                    {{ block.settings.gift_note }}
                  </span>
                {%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>

      <div class="bundle-offers__cta">
        <button
          type="button"
          class="button bundle-offers__button"
          data-bundle-offers-button
        >
          <span data-bundle-offers-button-text>{{ section.settings.button_label }}</span>
        </button>

        {%- if section.settings.shipping_note != blank -%}
          <p class="bundle-offers__note">{{ section.settings.shipping_note }}</p>
        {%- endif -%}

        <p
          class="bundle-offers__error"
          data-bundle-offers-error
          role="alert"
          hidden
        ></p>
      </div>
    </bundle-offers-component>
  </div>
</div>

{% stylesheet %}
  .bundle-offers__container {
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.5rem);
  }

  .bundle-offers__header {
    margin-block-end: var(--margin-lg, 1.5rem);
    text-align: center;
  }

  .bundle-offers__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--xl, 1.75rem);
    line-height: 1.15;
  }

  .bundle-offers__subheading {
    margin-block-start: 0.5rem;
    color: #777c80;
  }

  .bundle-offers__fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .bundle-offers__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--gap-md, 0.75rem);
  }

  .bundle-offers__offer {
    position: relative;
    display: block;
    border: 1px solid #c5c7c9;
    border-radius: 1rem;
    padding: 1rem 1.125rem;
    cursor: pointer;
    background-color: var(--color-background, #f7f7f5);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .bundle-offers__offer:hover {
    border-color: #171717;
  }

  .bundle-offers__offer--highlight {
    background-color: #f1f1ee;
  }

  .bundle-offers__offer:has(.bundle-offers__radio:checked) {
    border-color: #171717;
    box-shadow: inset 0 0 0 1px #171717;
  }

  .bundle-offers__offer:has(.bundle-offers__radio:focus-visible) {
    outline: 2px solid #171717;
    outline-offset: 2px;
  }

  .bundle-offers__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .bundle-offers__offer-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .bundle-offers__offer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .bundle-offers__offer-title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: #171717;
  }

  .bundle-offers__badge {
    flex-shrink: 0;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background-color: #171717;
    color: #f7f7f5;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bundle-offers__offer-description {
    font-size: 0.875rem;
    line-height: 1.45;
    color: #777c80;
  }

  .bundle-offers__offer-pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.25rem;
  }

  .bundle-offers__price {
    font-size: 1.25rem;
    font-weight: 700;
    color: #171717;
  }

  .bundle-offers__compare {
    font-size: 0.875rem;
    color: #777c80;
  }

  .bundle-offers__savings {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background-color: #e3e5e6;
    color: #171717;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .bundle-offers__gift {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #171717;
  }

  .bundle-offers__gift-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
  }

  .bundle-offers__gift-icon svg {
    width: 100%;
    height: 100%;
  }

  .bundle-offers__placeholder {
    border: 1px dashed #c5c7c9;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    color: #777c80;
    font-size: 0.875rem;
  }

  .bundle-offers__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    margin-block-start: var(--margin-md, 1.25rem);
  }

  .bundle-offers__button {
    width: 100%;
    max-width: 26rem;
    min-height: 3rem;
  }

  .bundle-offers__button[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .bundle-offers__note {
    margin: 0;
    max-width: 34rem;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #777c80;
  }

  .bundle-offers__error {
    margin: 0;
    color: #8a1f1f;
    font-size: 0.875rem;
  }

  @media screen and (min-width: 750px) {
    .bundle-offers__header {
      text-align: left;
    }

    .bundle-offers__cta {
      align-items: flex-start;
    }

    .bundle-offers__note {
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle offers",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_current_product",
          "label": "Use the current product (single-item offer)",
          "default": false
        },
        {
          "type": "product",
          "id": "product",
          "label": "Offer product",
          "info": "Create each bundle as its own product in Shopify admin, then select it here."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bundle"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": ""
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": ""
        },
        {
          "type": "number",
          "id": "compare_price",
          "label": "Compare-at price (optional, store currency)",
          "info": "Used to show strikethrough price and dollar savings. Falls back to the product compare-at price."
        },
        {
          "type": "text",
          "id": "gift_note",
          "label": "Free gift note",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight as recommended",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "default_selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUNDLES"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "One-click bundles. Free US shipping on orders over $29."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note",
      "default": "Delivery in 5-10 business days. Items in an order may arrive in separate packages."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Bundle offers",
      "blocks": {
        "offer_single": {
          "type": "offer",
          "settings": {
            "use_current_product": true,
            "title": "Just the mouse wrist rest",
            "description": "One Ergonomic Mouse Wrist Rest Pad for your current setup.",
            "default_selected": true,
            "highlight": false
          }
        },
        "offer_duo": {
          "type": "offer",
          "settings": {
            "title": "The Comfort Duo",
            "description": "Mouse + keyboard wrist rest. The classic desk comfort upgrade.",
            "badge": "Most popular",
            "compare_price": 37.98,
            "highlight": true
          }
        },
        "offer_complete": {
          "type": "offer",
          "settings": {
            "title": "The Complete Desk Setup",
            "description": "Both wrist rests + 8 magnetic cable clips to keep your desk tidy.",
            "compare_price": 70.96,
            "gift_note": "Free magic cleaning cloth included ($7.99 value)"
          }
        },
        "offer_pro": {
          "type": "offer",
          "settings": {
            "title": "The Pro Desk Setup",
            "description": "Both wrist rests + magnetic cable clips + 16 silicone cable ties.",
            "compare_price": 95.95,
            "gift_note": "Free magic cleaning cloth included ($7.99 value)"
          }
        }
      },
      "block_order": ["offer_single", "offer_duo", "offer_complete", "offer_pro"]
    }
  ]
}
{% endschema %}
