{% comment %}
  Displays infographic images (images that contain text) stacked in their own section below the product.

  Use this section to keep the main product gallery clean (photos only) and move images that
  contain text (feature callouts, size guides, comparison charts) here instead.
{% endcomment %}

<div
  class="product-infographics"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="product-infographics__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-infographics__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-infographics__stack" style="--stack-gap: {{ section.settings.gap }}px;">
      {%- for block in section.blocks -%}
        <div class="product-infographics__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="product-infographics__link" href="{{ block.settings.link }}">
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {% render 'image', image: block.settings.image, class: 'product-infographics__image' %}
          {%- elsif request.design_mode -%}
            <div class="product-infographics__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}

          {%- if block.settings.caption != blank -%}
            <p class="product-infographics__caption">{{ block.settings.caption }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-infographics__container {
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.5rem);
  }

  .product-infographics__heading {
    margin: 0 0 var(--margin-lg, 1.5rem);
    font-family: var(--font-heading--family);
    font-size: var(--font-size--xl, 1.75rem);
    line-height: 1.15;
    text-align: center;
  }

  .product-infographics__stack {
    display: flex;
    flex-direction: column;
    gap: var(--stack-gap, 12px);
    max-width: 56rem;
    margin-inline: auto;
  }

  .product-infographics__link {
    display: block;
  }

  .product-infographics__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--border-radius, 24px);
  }

  .product-infographics__placeholder {
    border-radius: var(--border-radius, 24px);
    overflow: hidden;
  }

  .product-infographics__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-infographics__caption {
    margin: 0.5rem 0 0;
    text-align: center;
    color: #777c80;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product infographics",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product infographics",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
